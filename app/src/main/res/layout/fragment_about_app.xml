<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_about_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- 1. CONSTANT BANNER CARD (Fixed Deep Maroon - Never changes across themes) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_banner_header"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#5C0011">

            <ImageView
                android:id="@+id/iv_app_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/banner_about_app"
                android:contentDescription="தமிழ் நாட்காட்டி" />
        </androidx.cardview.widget.CardView>

        <!-- 2. FEATURES CARD (Dynamic Contrast Theming) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:id="@+id/ll_features_inner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_features_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="முக்கிய அம்சங்கள்"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_features_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• துல்லியமான தினசரி பஞ்சாங்கம் (திதி, நட்சத்திரம், யோகம், கரணம்)\n\n• நல்ல நேரம், கௌரி பஞ்சாங்கம், சுப முகூர்த்த நாட்கள்\n\n• கிரக ஹோரை கால அட்டவணை மற்றும் விரத நாட்கள்\n\n• 5x7 பாரம்பரிய மாத காலண்டர் காட்சி\n\n• 4 விட்ஜெட் அளவுகள் (2x1, 4x1, 4x2, 4x4) டிஜிட்டல் &amp; அனலாக் பாணிகளுடன்\n\n• 100% ஆஃப்லைன் பயன்பாடு (இணையம் தேவையில்லை)"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. ACTIONS: SHARE & FEEDBACK (Auto-fit sizing) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_share_app"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="பகிர்க (Share)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_feedback"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="கருத்து (Feedback)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 4. APP VERSION & FOOTER -->
        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="பதிப்பு 1.0.0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_footer_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை © 2026"
            android:textSize="11.5sp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Card: Current Horai & Day Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/crimson_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_horai_day_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="இன்றைய சுப ஓரைகள்"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/tv_current_horai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="சுப ஓரைகள்: குரு, சுக்கிரன், புதன், சந்திரன்"
                    android:textSize="13sp"
                    android:textColor="#FFD54F" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Legend Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● உத்தமம் (சுபம்)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/horai_good_text"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● மத்திமம்"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/horai_medium_text"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● தவிர்க்கவும்"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/horai_avoid_text" />
        </LinearLayout>

        <!-- Section: Daytime Horai Table (பகல் ஓரை) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="பகல் ஓரை (காலை 6:00 - மாலை 6:00)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/traditional_maroon" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/card_surface_light"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border_subtle">

            <LinearLayout
                android:id="@+id/layout_day_horai_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Nighttime Horai Table (இரவு ஓரை) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="இரவு ஓரை (மாலை 6:00 - காலை 6:00)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/traditional_maroon" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/card_surface_light"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border_subtle">

            <LinearLayout
                android:id="@+id/layout_night_horai_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

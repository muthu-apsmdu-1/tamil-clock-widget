<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/themeCanvasBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 1. Day / Night Pill Segmented Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_widget_card"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_toggle_day_horai"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_header_btn_ripple"
                android:text="பகல் ஹோரை"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/btn_toggle_night_horai"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="இரவு ஹோரை"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3C3C43" />
        </LinearLayout>

        <!-- 2. Section Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_horai_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="பகல் ஹோரை நேரங்கள்"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#5D0A14" />

            <TextView
                android:id="@+id/tv_horai_section_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="(சூரிய உதயம் - சூரிய அஸ்தமனம்)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E" />
        </LinearLayout>

        <!-- 3. Day Horai Container -->
        <LinearLayout
            android:id="@+id/layout_day_horai_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 4. Night Horai Container -->
        <LinearLayout
            android:id="@+id/layout_night_horai_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

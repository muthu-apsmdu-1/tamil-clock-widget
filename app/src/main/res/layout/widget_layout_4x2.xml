<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_surface_bg">

    <!-- Clock Container (2x2) Left -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center_vertical">

        <AnalogClock
            android:id="@+id/analog_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <TextClock
            android:id="@+id/digital_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFDF00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 4 Rows on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical">

        <!-- Row 1: dd: mm: yyyy + week day in english -->
        <TextView
            android:id="@+id/tv_widget_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="01: 11: 2026 Sunday" />

        <!-- Row 2: Tamil month + tamil date + paksham -->
        <TextView
            android:id="@+id/tv_widget_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFDF00"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="ஐப்பசி 15 • கிருஷ்ண பக்ஷம்" />

        <!-- Row 3: Thithi + timing + nakshatra + timing -->
        <TextView
            android:id="@+id/tv_widget_row3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E0E0E0"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:text="சப்தமி 19:24 • புனர்பூசம் 10:37" />

        <!-- Row 4: Aspecius time ந.நே : + timing -->
        <TextView
            android:id="@+id/tv_widget_row4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#81C784"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="ந.நே : 07:45 - 08:45 / 03:15 - 04:15" />
    </LinearLayout>
</LinearLayout>

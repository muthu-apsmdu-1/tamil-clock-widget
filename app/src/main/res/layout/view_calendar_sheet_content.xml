<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Weekday Header Row (ஞா, தி, செ, பு, வி, வெ, ச) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ஞா"
            android:textColor="#FF8A80"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="தி"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="செ"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="பு"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="வி"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="வெ"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ச"
            android:textColor="#FFD54F"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 7-Column Day Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_month_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- Muhurtham / Festival Highlights Container (Shown in Full-Screen Expanded Mode) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="மாத முக்கிய விசேஷங்கள் &amp; முகூர்த்த நாட்கள்"
        android:textColor="@color/text_gold_accent"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_sheet_month_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="தீபாவளி பண்டிகை, கந்த சஷ்டி விரதம் ஆரம்பம், சுப முகூர்த்த தினம்."
        android:textColor="@color/text_white"
        android:textSize="12sp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background Bitmap Layer (Receives safe runtime theme color/alpha) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- 2. Main Content Container (Padded inside the capsule border) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <!-- Top Section (Horizontal Split: Left Clock, Right Date Stack) -->
        <LinearLayout
            android:id="@+id/layout_top_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/layout_row4_container"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Clock Frame (Supports both Analog & Digital) -->
            <FrameLayout
                android:id="@+id/layout_clock_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp">

                <!-- Analog Clock Mode -->
                <AnalogClock
                    android:id="@+id/ac_classic_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dial="@drawable/classic_clock_dial"
                    android:hand_hour="@drawable/classic_clock_hour"
                    android:hand_minute="@drawable/classic_clock_minute"
                    android:visibility="visible" />

                <!-- Digital Clock Mode (Large time digits + small AM/PM) -->
                <LinearLayout
                    android:id="@+id/digital_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFDF00"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#FFDF00"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- Center Gold Divider Line -->
            <View
                android:id="@+id/view_split_divider"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="6dp"
                android:background="#FFDF00" />

            <!-- Right: Date Column (Rows 1, 2, 3) -->
            <LinearLayout
                android:id="@+id/layout_date_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:orientation="vertical">

                <!-- Row 1: Gregorian Date -->
                <TextView
                    android:id="@+id/tv_gregorian_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22 - 10 - 2026"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <!-- Row 2: Weekday -->
                <TextView
                    android:id="@+id/tv_weekday_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="வியாழன்"
                    android:textSize="14sp"
                    android:textColor="#FFDF00"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <!-- Row 3: Tamil Month & Date -->
                <TextView
                    android:id="@+id/tv_tamil_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="ஐப்பசி 5"
                    android:textSize="16sp"
                    android:textColor="#FFDF00"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Section: Row 4 Full Width Container -->
        <LinearLayout
            android:id="@+id/layout_row4_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Option Choice 1 Chip -->
            <TextView
                android:id="@+id/tv_row4_chip1"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#26FFFFFF"
                android:gravity="center"
                android:text="பராபவ வருடம்"
                android:textSize="11sp"
                android:textColor="#E0E0E0"
                android:singleLine="true" />

            <!-- Option Choice 2 Chip -->
            <TextView
                android:id="@+id/tv_row4_chip2"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#26FFFFFF"
                android:gravity="center"
                android:text="வளர்பிறை"
                android:textSize="11sp"
                android:textColor="#FFDF00"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>

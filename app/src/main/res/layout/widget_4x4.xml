<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x4_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- 1. Hero Centered Clock -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_clock_square_ivory"
        android:padding="8dp">

        <AnalogClock
            android:id="@+id/clock_analog_4x4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:dial="@drawable/clock_dial_classic"
            android:visibility="visible" />

        <TextClock
            android:id="@+id/clock_digital_4x4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#36060B"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 2. Thin Brass / Gold Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#D4AF37" />

    <!-- 3. Date & Tamil Block -->
    <TextView
        android:id="@+id/tv_4x4_greg_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24 - 10 - 2026 | சனிக்கிழமை"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tv_4x4_tamil_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="பராபவ வருடம் - ஐப்பசி 7"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFDF00" />

    <TextView
        android:id="@+id/tv_4x4_tithi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="திரியோதசி"
        android:textSize="13sp"
        android:textColor="#E0DACB" />

    <!-- 4. User Toggleable Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tv_4x4_nakshatra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ நட்சத்திரம்: உத்திரட்டாதி (8.13 pm வரை)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFDF0" />

        <TextView
            android:id="@+id/tv_4x4_nalla_neram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="☉ ந.நேரம்: காலை 10.45 - 11.45 | மாலை 4.45 - 5.45"
            android:textSize="10sp"
            android:textColor="#A7F3D0" />

        <TextView
            android:id="@+id/tv_4x4_rahu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="⊘ இராகு: 09:00 AM - 10:30 AM"
            android:textSize="10sp"
            android:textColor="#FCA5A5" />

        <TextView
            android:id="@+id/tv_4x4_yamagandam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="☠ எமகண்டம்: 01:30 PM - 03:00 PM"
            android:textSize="10sp"
            android:textColor="#FED7AA"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E24"
    android:orientation="vertical">

    <!-- 1. Permanent Title Banner (All Pages) -->
    <TextView
        android:id="@+id/tv_app_title_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_gold_header_texture"
        android:includeFontPadding="false"
        android:text="தமிழ் நாட்காட்டி"
        android:textColor="#FFD043"
        android:textSize="22sp"
        android:textStyle="bold"
        android:shadowColor="#1A0000"
        android:shadowDx="1.5"
        android:shadowDy="2.0"
        android:shadowRadius="2.0" />

    <!-- 2. Permanent 7-Toolbox Navigation Row (All Pages) -->
    <LinearLayout
        android:id="@+id/layout_nav_toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="7">

        <TextView
            android:id="@+id/btn_action_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="❮❮"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_action_datepicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="📅"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="🏠"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_horai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="☸"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="❯❯"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. ViewPager2 Container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

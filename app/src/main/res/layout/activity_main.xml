<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Pinned Top Banner: App Logo + தமிழ் நாட்காட்டி -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_top_banner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:id="@+id/ll_banner_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iv_app_logo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Logo" />

            <TextView
                android:id="@+id/tv_app_title_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:text="தமிழ் நாட்காட்டி"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. Permanent 7-Toolbox Navigation Row -->
    <!-- Exact Order: Prev <<, About App ☰, Monthly Calendar 🗓️, Home 🏠, Gowri/Horai ☸, Settings ⚙, Next >> -->
    <LinearLayout
        android:id="@+id/layout_nav_toolbar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:weightSum="7">

        <!-- 1. Previous Day (<<) -->
        <TextView
            android:id="@+id/btn_action_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="❮❮"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 2. About App Page (☰) -->
        <TextView
            android:id="@+id/btn_action_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="☰"
            android:textSize="18sp" />

        <!-- 3. Monthly Calendar (🗓️) -->
        <TextView
            android:id="@+id/btn_action_datepicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="🗓️"
            android:textSize="18sp" />

        <!-- 4. Home Page (🏠) -->
        <TextView
            android:id="@+id/btn_action_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="🏠"
            android:textSize="18sp" />

        <!-- 5. Gowri & Horai Integrated Page (☸) -->
        <TextView
            android:id="@+id/btn_action_horai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="☸"
            android:textSize="18sp" />

        <!-- 6. Settings Page (⚙) -->
        <TextView
            android:id="@+id/btn_action_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="⚙"
            android:textSize="18sp" />

        <!-- 7. Next Day (>>) -->
        <TextView
            android:id="@+id/btn_action_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1.5dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="❯❯"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. ViewPager2 Container (5 Pages) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

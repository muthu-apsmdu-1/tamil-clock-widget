<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="இன்றைய பஞ்சாங்கம்"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFEB3B" />

        <TextView
            android:id="@+id/tv_panchangam_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="6dp"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget Appearance"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Live Preview Box -->
        <LinearLayout
            android:id="@+id/preview_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/widget_background">

            <TextView
                android:id="@+id/preview_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 : 30 AM"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFEB3B" />

            <TextView
                android:id="@+id/preview_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="புதன் - ஐப்பசி 4"
                android:textSize="16sp"
                android:textColor="#FFEB3B" />
        </LinearLayout>

        <!-- Text Color Choices -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Text Color"
            android:textSize="15sp"
            android:textColor="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_color_yellow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Yellow" />

            <Button
                android:id="@+id/btn_color_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="White" />

            <Button
                android:id="@+id/btn_color_cyan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cyan" />
        </LinearLayout>

        <!-- Transparency Slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Background Transparency"
            android:textSize="15sp"
            android:textColor="#CCCCCC" />

        <SeekBar
            android:id="@+id/seek_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="255"
            android:progress="80" />

        <Button
            android:id="@+id/btn_save_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Apply to Widget" />

    </LinearLayout>
</ScrollView>

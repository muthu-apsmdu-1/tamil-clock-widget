<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp"
    android:background="@drawable/widget_surface_bg">

    <!-- 9. பெரிய கடிகார டயல் (220dp) -->
    <RelativeLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal">

        <AnalogClock
            android:id="@+id/analog_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/classic_clock_dial"
            android:visibility="visible" />

        <!-- பெரிய டிஜிட்டல் கடிகாரம் -->
        <TextClock
            android:id="@+id/digital_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="#FFDF00"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 11. டயலின் மையப்புள்ளிக்குக் கீழ் (bottom half) தேதி & கிழமை -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="35dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_widget_dial_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E1E24"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:shadowColor="#FFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="08: 11: 2026" />

            <TextView
                android:id="@+id/tv_widget_dial_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#800000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#FFFFFF"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="Sunday" />
        </LinearLayout>
    </RelativeLayout>

    <!-- கடிகாரத்திற்கு கீழே உள்ள வரிகள் -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_widget_4x4_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFDF00"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_4x4_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#E0E0E0"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>

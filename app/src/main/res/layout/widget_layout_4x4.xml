<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background Bitmap Layer -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- 2. Main Vertical Split (6:4) with Minimized Nesting -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- UPPER 60% (weight 6): Clock Area + Live Horai + Live Gowri + Next Horai/Gowri Row -->
        <FrameLayout
            android:id="@+id/container_upper_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6">

            <!-- Clock Area (Center) -->
            <FrameLayout
                android:id="@+id/container_clock_top"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/iv_hybrid_dial_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Analog Dial" />

                <AnalogClock
                    android:id="@+id/analog_clock_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:dial="@drawable/classic_clock_dial"
                    android:hand_hour="@drawable/classic_clock_hour"
                    android:hand_minute="@drawable/classic_clock_minute"
                    android:visibility="gone" />

                <TextClock
                    android:id="@+id/tc_hybrid_top_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="46dp"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#00F5D4"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_digital_clock_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="12dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Neon Digital Pill" />

                <LinearLayout
                    android:id="@+id/container_digital_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="visible">

                    <TextClock
                        android:id="@+id/tv_digital_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/tv_digital_clock_ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

            </FrameLayout>

            <!-- Live Horai (Left Flank: Small Timing + Big Name) -->
            <LinearLayout
                android:id="@+id/container_top_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tv_widget_live_horai_time_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:textSize="9sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_widget_live_horai_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="start"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Live Gowri (Right Flank: Small Timing + Big Name) -->
            <LinearLayout
                android:id="@+id/container_top_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_widget_live_gowri_time_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="9sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_widget_live_gowri_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="end"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Next Horai/Gowri Row (Bottom of Upper Frame, Full Width) -->
            <TextView
                android:id="@+id/tv_widget_horai_gowri_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textStyle="normal"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:visibility="gone" />

        </FrameLayout>

        <!-- BOTTOM 40% (weight 4): All Other Contents Stacked -->
        <FrameLayout
            android:id="@+id/container_lower_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4">

            <LinearLayout
                android:id="@+id/container_elements_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/tv_widget_row1_fixed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_row2_opt1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_row3_opt2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_row4_opt3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>

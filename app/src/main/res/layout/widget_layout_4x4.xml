<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background Bitmap Layer (Theme color, opacity, rounded corners & border) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- 2. Main Vertical Split: Clock (Top 2/3) + Elements (Bottom 1/3) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:weightSum="3"
        android:gravity="center_horizontal">

        <!-- TOP 2/3: Clock Container (Horizontally & Vertically Centered) -->
        <FrameLayout
            android:id="@+id/container_clock_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_gravity="center">

            <!-- Classic Vintage Analog Clock (Direct on theme background, no extra plate) -->
            <AnalogClock
                android:id="@+id/analog_clock_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:dial="@drawable/classic_clock_dial"
                android:hand_hour="@drawable/classic_clock_hour"
                android:hand_minute="@drawable/classic_clock_minute"
                android:visibility="gone" />

            <!-- Digital Clock: Big time font with half-size AM/PM bound via SpannableString -->
            <TextView
                android:id="@+id/tv_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="38sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Horizontal Divider -->
        <View
            android:id="@+id/view_center_divider"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginVertical="3dp"
            android:layout_marginHorizontal="6dp"
            android:background="#44FFDF00" />

        <!-- BOTTOM 1/3: Elements in Rows (Weight 1) -->
        <LinearLayout
            android:id="@+id/container_elements_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="4"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <!-- Row 1 (Fixed): Gregorian Date + Tamil Weekday + Tamil Month & Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_fixed_sep1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_fixed_sep2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_tamil_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Row 2: Selected Options (Paragraph style with " | " separator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_row2_paragraph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Row 3: Selected Options (Paragraph style with " | " separator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_row3_paragraph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Row 4: Selected Options (Paragraph style with " | " separator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_row4_paragraph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

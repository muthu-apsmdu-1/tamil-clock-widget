<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background Bitmap Layer -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- 2. Main Vertical Split: Clock (Top) + Bottom-Aligned Info Rows (Bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:gravity="center_horizontal">

        <!-- TOP: Clock Container -->
        <FrameLayout
            android:id="@+id/container_clock_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/iv_hybrid_dial_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Analog Dial" />

            <AnalogClock
                android:id="@+id/analog_clock_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:dial="@drawable/classic_clock_dial"
                android:hand_hour="@drawable/classic_clock_hour"
                android:hand_minute="@drawable/classic_clock_minute"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/tc_hybrid_top_digital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="48dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#00F5D4"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_digital_clock_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="12dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:contentDescription="Neon Digital Pill" />

            <LinearLayout
                android:id="@+id/container_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextClock
                    android:id="@+id/tv_digital_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/tv_digital_clock_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </FrameLayout>

        <!-- BOTTOM: 4 Bottom-Aligned Rows -->
        <LinearLayout
            android:id="@+id/container_elements_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom|center_horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tv_widget_row1_fixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_widget_row2_opt1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="normal"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_widget_row3_opt2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="normal"
                android:maxLines="1"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_widget_row4_opt3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="normal"
                android:maxLines="1"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

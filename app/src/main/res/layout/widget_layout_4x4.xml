<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===================================================== -->
    <!-- 1. DYNAMIC BACKGROUND / OPACITY / OUTER BORDER         -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />


    <!-- ===================================================== -->
    <!-- 2. MAIN WIDGET CONTAINER                               -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/container_widget_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">


        <!-- ================================================= -->
        <!-- SEGMENT 1: TOP THREE-COLUMN ARRANGEMENT            -->
        <!-- LEFT INFO | CLOCK | RIGHT INFO                    -->
        <!-- NO VISIBLE DIVIDERS                                -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/container_clock_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:minHeight="132dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- LEFT INFORMATION PANEL -->

            <TextView
                android:id="@+id/tv_widget_live_horai_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:includeFontPadding="false"
                android:maxLines="4"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible" />


            <!-- CENTRE CLOCK ZONE -->

            <FrameLayout
                android:id="@+id/container_clock_center"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- HYBRID ANALOG DIAL BACKGROUND -->

                <ImageView
                    android:id="@+id/iv_hybrid_dial_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null" />


                <!-- CLASSIC / THEME ANALOG CLOCK -->

                <AnalogClock
                    android:id="@+id/analog_clock_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:padding="4dp"
                    android:dial="@drawable/classic_clock_dial"
                    android:hand_hour="@drawable/classic_clock_hour"
                    android:hand_minute="@drawable/classic_clock_minute"
                    android:visibility="gone" />


                <!-- HYBRID SECONDARY DIGITAL READOUT -->

                <TextClock
                    android:id="@+id/tc_hybrid_top_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="18dp"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#00F5D4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:visibility="gone" />


                <!-- DIGITAL CLOCK BACKGROUND -->

                <ImageView
                    android:id="@+id/iv_digital_clock_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="8dp"
                    android:scaleType="fitXY"
                    android:visibility="gone"
                    android:contentDescription="@null" />


                <!-- DIGITAL CLOCK CONTAINER -->

                <LinearLayout
                    android:id="@+id/container_digital_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextClock
                        android:id="@+id/tv_digital_clock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/tv_digital_clock_ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>


            <!-- RIGHT INFORMATION PANEL -->

            <TextView
                android:id="@+id/tv_widget_live_gowri_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:includeFontPadding="false"
                android:maxLines="4"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SEGMENT 2: HORAI / GOWRI FULL-WIDTH BAND           -->
        <!-- NO VISIBLE DIVIDERS                                -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/container_horai_gowri_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/tv_widget_horai_gowri_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SEGMENT 3: GREGORIAN DATE + TAMIL MONTH / WEEKDAY  -->
        <!-- NO VISIBLE DIVIDERS                                -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tv_widget_row1_fixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="normal" />


        <!-- ================================================= -->
        <!-- ONLY VISIBLE INTERNAL HORIZONTAL DIVIDER          -->
        <!-- BELOW TAMIL DATE ROW                               -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#665B3A" />


        <!-- ================================================= -->
        <!-- SEGMENT 4: BOTTOM OPTIONAL INFORMATION PANEL      -->
        <!-- NO DIVIDERS BETWEEN OPTIONAL ROWS                  -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/container_elements_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:minHeight="70dp"
            android:gravity="center"
            android:orientation="vertical">


            <!-- BOTTOM ROW 1 -->

            <TextView
                android:id="@+id/tv_widget_row2_opt1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="normal" />


            <!-- BOTTOM ROW 2 -->

            <TextView
                android:id="@+id/tv_widget_row3_opt2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="normal" />


            <!-- BOTTOM ROW 3 -->

            <TextView
                android:id="@+id/tv_widget_row4_opt3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="normal" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

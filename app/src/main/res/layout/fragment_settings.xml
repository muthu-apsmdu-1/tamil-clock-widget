<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Page Heading -->
        <TextView
            android:id="@+id/tv_settings_main_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="அமைப்புகள் (Settings)"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. APP BACKGROUND THEME SELECTION -->
        <TextView
            android:id="@+id/tv_lbl_app_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="செயலி பின்னணி நிறம் (App Background)"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_app_theme_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp" />

        <View
            android:id="@+id/divider_settings_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- 2. WIDGET BACKGROUND COLOR SELECTION -->
        <TextView
            android:id="@+id/tv_lbl_widget_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="விட்ஜெட் பின்னணி நிறம் (Widget Background)"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_widget_theme_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp" />

        <View
            android:id="@+id/divider_settings_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- 3. WIDGET OPACITY ADJUSTMENT -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_lbl_widget_opacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="விட்ஜெட் ஒளிபுகா தன்மை (Opacity)"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_opacity_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="85%"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <SeekBar
            android:id="@+id/seekbar_widget_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="85"
            android:layout_marginBottom="18dp" />

        <!-- 4. WIDGET LIVE PREVIEW CARD -->
        <TextView
            android:id="@+id/tv_lbl_widget_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="விட்ஜெட் நேரலை மாதிரி (Live Preview)"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/frame_preview_wrapper"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:elevation="2dp"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_preview_widget_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Widget Background Preview" />

            <LinearLayout
                android:id="@+id/layout_preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="தமிழ் நாட்காட்டி விட்ஜெட்"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="நேரலை மாதிரி • 85%"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>

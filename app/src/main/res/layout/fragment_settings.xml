<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Heading -->
        <TextView
            android:id="@+id/tv_settings_main_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="அமைப்புகள் (Settings)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 1. APP BACKGROUND (5-BOX GRID) ==================== -->
        <TextView
            android:id="@+id/tv_lbl_app_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="பயன்பாட்டு பின்னணி (App Background)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Row 1: Antique Sandal, Bright Lemon, Midnight Violet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/box_app_antique_sandal"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_app_antique_sandal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="சந்தனம்\n(Sandal)"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_app_antique_sandal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_app_bright_lemon"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_app_bright_lemon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="எலுமிச்சை\n(Lemon)"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_app_bright_lemon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_app_midnight_violet"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_app_midnight_violet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="நள்ளிரவு\n(Violet)"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_app_midnight_violet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Row 2: Off-White, AMOLED Black -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/box_app_off_white"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_app_off_white"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="வெள்ளை\n(Off-White)"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_app_off_white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_app_amoled_black"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_app_amoled_black"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="அமோலெட்\n(AMOLED Black)"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_app_amoled_black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 2. WIDGET 6-BOX PRESETS ==================== -->
        <TextView
            android:id="@+id/tv_lbl_widget_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="விட்ஜெட் தீம் முன்னமைப்புகள் (Widget Presets)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Row 1: Midnight Gold & Heritage Maroon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/box_preset_midnight_gold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_midnight_gold"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Midnight Gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_midnight_gold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_heritage_maroon"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_heritage_maroon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Heritage Maroon"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_heritage_maroon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Row 2: Classic Mono & Neon Night -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/box_preset_classic_mono"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_classic_mono"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Classic Mono"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_classic_mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_neon_night"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_neon_night"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Neon Night"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_neon_night"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Row 3: Porcelain Blue & Porcelain Red -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/box_preset_porcelain_blue"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_porcelain_blue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Porcelain Blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_porcelain_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_porcelain_red"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_porcelain_red"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Porcelain Red"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tick_preset_porcelain_red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:text="✓"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 3A. WIDGET DATE FORMAT SELECTOR ==================== -->
        <TextView
            android:id="@+id/tv_lbl_date_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="தேதி வடிவம் (Widget Date Format)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:id="@+id/box_date_fmt_dash"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_preset_box_base"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_date_fmt_dash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="14 - 11 - 2026"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/box_date_fmt_text"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_preset_box_base"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_date_fmt_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="14 Nov 2026"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/box_date_fmt_slash"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_preset_box_base"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_date_fmt_slash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="14/11/2026"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 3B. CLOCK TYPE & SAMPLE IMAGE CARDS ==================== -->
        <TextView
            android:id="@+id/tv_lbl_clock_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="கடிகார வகை &amp; வடிவம் (Clock Type &amp; Face)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Clock Type: Digital vs Analog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:id="@+id/box_clock_digital"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_preset_box_base"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_clock_digital"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="டிஜிட்டல் (Digital)"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tick_clock_digital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/box_clock_analog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_preset_box_base"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_clock_analog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="அனலாக் (Analog)"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tick_clock_analog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Digital Sub-Options (2 Cards with Sample Preview Images) -->
        <LinearLayout
            android:id="@+id/group_digital_faces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/card_face_digital_classic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_thumb_digital_classic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Classic Digital Sample" />

                <TextView
                    android:id="@+id/tv_label_digital_classic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Transparent + White"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_face_digital_neon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_thumb_digital_neon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="AMOLED Neon Digital Sample" />

                <TextView
                    android:id="@+id/tv_label_digital_neon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="AMOLED + Neon"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Analog Sub-Options (3 Cards with Sample Preview Images) -->
        <LinearLayout
            android:id="@+id/group_analog_faces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/card_face_analog_classic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_thumb_analog_classic"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Classic Transparent Dial" />

                <TextView
                    android:id="@+id/tv_label_analog_classic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Classic\nTransparent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_face_analog_white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_thumb_analog_white"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="AMOLED White + Seconds" />

                <TextView
                    android:id="@+id/tv_label_analog_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="AMOLED White\n+ Seconds"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_face_analog_hybrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_thumb_analog_hybrid"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="AMOLED Teal Hybrid Dial" />

                <TextView
                    android:id="@+id/tv_label_analog_hybrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="AMOLED Teal\nHybrid + Sec"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 4. OUTER BORDER & LIVE HORAI/GOWRI TOGGLES ==================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_lbl_outer_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="வெளிப்புற பார்டர் (Outer Border)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_outer_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_lbl_live_horai_gowri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="நேரலை ஹோரை &amp; கௌரி (Live Horai &amp; Gowri)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_live_horai_gowri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 5. OPACITY CAPSULE CARD (LIVE ALPHA) ==================== -->
        <LinearLayout
            android:id="@+id/card_slider_capsule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_slider_capsule_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_lbl_widget_opacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="பின்னணி ஒளிபுகாமை (Opacity)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_opacity_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#FFDF00"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_widget_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 6. 4x2 ELEMENTS TABLE (UP TO 3) ==================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_lbl_elements_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="4x2 விட்ஜெட் தகவல் கூறுகள்"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_count_elements_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="(3/3)"
                android:textColor="#FFDF00"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Dynamic Table Container for 4x2 -->
        <LinearLayout
            android:id="@+id/table_elements_4x2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 7. 4x4 SINGLE-ROW OPTIONS TABLE (UP TO 3 OF 10) ==================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_lbl_elements_4x4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="4x4 விட்ஜெட் வரிசைத் தேர்வு"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_count_elements_4x4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="(3/3)"
                android:textColor="#FFDF00"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Dynamic Table Container for 4x4 -->
        <LinearLayout
            android:id="@+id/table_elements_4x4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 8. LIVE PREVIEW ==================== -->
        <TextView
            android:id="@+id/tv_lbl_widget_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="நேரலை மாதிரி (Live Preview)"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/frame_preview_wrapper"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_preview_widget_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Widget Background Preview" />

            <LinearLayout
                android:id="@+id/layout_preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="தமிழ் நாட்காட்டி விட்ஜெட்"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="நேரலை மாதிரி • 100%"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>

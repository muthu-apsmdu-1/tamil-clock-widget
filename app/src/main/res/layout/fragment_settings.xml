<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Title -->
        <TextView
            android:id="@+id/tv_settings_main_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="அமைப்புகள் (Settings)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 1. APP BACKGROUND ==================== -->
        <TextView
            android:id="@+id/tv_lbl_app_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="பயன்பாட்டு பின்னணி (App Background)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_app_theme_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 2. WIDGET 6-BOX PRESETS ==================== -->
        <TextView
            android:id="@+id/tv_lbl_widget_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="விட்ஜெட் தீம் முன்னமைப்புகள் (Widget Presets)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- 6 Presets in 3 Rows x 2 Columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Row 1: Midnight Gold & Heritage Maroon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/box_preset_midnight_gold"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_midnight_gold"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Midnight Gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_heritage_maroon"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_heritage_maroon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Heritage Maroon"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Row 2: Classic Mono & Neon Night -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:id="@+id/box_preset_classic_mono"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_classic_mono"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Classic Mono"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_neon_night"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_neon_night"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Neon Night"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Row 3: Porcelain Blue & Porcelain Red -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/box_preset_porcelain_blue"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_porcelain_blue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Porcelain Blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/box_preset_porcelain_red"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_preset_box_base"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_preset_porcelain_red"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Porcelain Red"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 3. OUTER BORDER TOGGLE ==================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_lbl_outer_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="வெளிப்புற பார்டர் (Outer Border)"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_outer_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22888888"
            android:layout_marginBottom="16dp" />

        <!-- ==================== 4. OPACITY CAPSULE CARD ==================== -->
        <LinearLayout
            android:id="@+id/card_slider_capsule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_slider_capsule_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_lbl_widget_opacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="பின்னணி ஒளிபுகாமை (Opacity)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_opacity_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="100%"
                    android:textColor="#FFDF00"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <SeekBar
                android:id="@+id/seekbar_widget_opacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />
        </LinearLayout>

        <!-- ==================== 5. LIVE PREVIEW ==================== -->
        <TextView
            android:id="@+id/tv_lbl_widget_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="நேரலை மாதிரி (Live Preview)"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/frame_preview_wrapper"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_preview_widget_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Widget Background Preview" />

            <LinearLayout
                android:id="@+id/layout_preview_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="தமிழ் நாட்காட்டி விட்ஜெட்"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_preview_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="நேரலை மாதிரி • 100%"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>

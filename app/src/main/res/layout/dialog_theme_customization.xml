<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#24242C"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#888888" />

    <!-- 1. கடிகார முறை (Clock Style) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Clock Style"
        android:textColor="#FFDF00"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_style_analog"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Classic"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:backgroundTint="#1A6B75" />

        <Button
            android:id="@+id/btn_style_digital"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Digital"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:backgroundTint="#1A6B75" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#444450" />

    <!-- 2. ஒளிபுகாமை (Opacity) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opacity"
            android:textColor="#FFDF00"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_opacity_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="85%" />
    </RelativeLayout>

    <SeekBar
        android:id="@+id/seekbar_widget_opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="85"
        android:progressTint="#FFDF00"
        android:thumbTint="#FFDF00"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#444450" />

    <!-- 3. தீம் தேர்வு (Default Maroon + 4 Themes) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Background colours"
        android:textColor="#FFDF00"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 0. Default: பாரம்பர்ய மெரூன் (Heritage Maroon) -->
    <RelativeLayout
        android:id="@+id/option_theme_maroon"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">
        <View
            android:id="@+id/v_maroon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:background="#78000C" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/v_maroon"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:text="Maroon (default)"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/check_theme_maroon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 1. தூய வெள்ளை (Classic White) -->
    <RelativeLayout
        android:id="@+id/option_theme_white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">
        <View
            android:id="@+id/v_white"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:background="#FFFFFF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/v_white"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:text="White"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/check_theme_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 2. மங்கள மஞ்சள் (Warm Yellow) -->
    <RelativeLayout
        android:id="@+id/option_theme_yellow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">
        <View
            android:id="@+id/v_yellow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:background="#FFF9E6" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/v_yellow"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:text="Yellow"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/check_theme_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 3. மென் பச்சை (Soft Green) -->
    <RelativeLayout
        android:id="@+id/option_theme_green"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">
        <View
            android:id="@+id/v_green"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:background="#1B4D3E" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/v_green"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:text="Green"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/check_theme_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 4. கரிம கருப்பு (Charcoal Dark) -->
    <RelativeLayout
        android:id="@+id/option_theme_charcoal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">
        <View
            android:id="@+id/v_dark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:background="#1E1E24" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/v_dark"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:text="Black"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp" />
        <TextView
            android:id="@+id/check_theme_charcoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/card_surface_light"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Rasi Name & Planet Lord -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_rasi_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="மேஷம்"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/traditional_maroon" />

            <TextView
                android:id="@+id/tv_rasi_lord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row4_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="செவ்வாய்"
                android:textSize="11sp"
                android:textColor="@color/text_gold_accent" />
        </LinearLayout>

        <!-- Prediction Summary -->
        <TextView
            android:id="@+id/tv_rasi_prediction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="தொழிலில் மேன்மை உண்டாகும். சுப காரிய முயற்சிகள் கைகூடும்."
            android:textSize="12sp"
            android:textColor="@color/text_primary_dark"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Lucky Chip Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_rasi_lucky_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="எண்: 9"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_dark"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_rasi_lucky_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="நிறம்: சிவப்பு"
                android:textSize="11sp"
                android:textColor="@color/text_secondary_dark" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

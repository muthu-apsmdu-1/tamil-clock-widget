<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/themeCardBackground"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/themeCardStroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <!-- Deep Maroon Circular Disc for Zodiac Icon -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_header_btn_ripple">

            <ImageView
                android:id="@+id/iv_rasi_icon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:src="@drawable/clock_dial_classic" />
        </FrameLayout>

        <!-- Rasi Name and Keyword Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_rasi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="மேஷம்"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0B2545" />

            <TextView
                android:id="@+id/tv_rasi_prediction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="பெருமை"
                android:textSize="15sp"
                android:textColor="#1C1C1E" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_calendar_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E5EA"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ================= 1. SIMPLE COMPACT VIEW ================= -->
        <LinearLayout
            android:id="@+id/layout_mode_simple"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_simple_day_num"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="24"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E" />

            <View
                android:id="@+id/dot_simple_indicator"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:background="#5D0A14"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- ================= 2. CLASSIC FULL WALL VIEW ================= -->
        <LinearLayout
            android:id="@+id/layout_mode_classic"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:padding="3dp"
            android:background="#FFFFFD"
            android:visibility="gone">

            <!-- Top Row: English Date & Tithi Short Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_classic_greg_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E" />

                <TextView
                    android:id="@+id/tv_classic_festival_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="பௌ"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#5D0A14"
                    android:paddingHorizontal="3dp"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Center: Tamil Date -->
            <TextView
                android:id="@+id/tv_classic_tamil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ஐப்பசி 7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#800000" />

            <!-- Bottom: Daily Event / Nalla Neram hint -->
            <TextView
                android:id="@+id/tv_classic_extra_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="சுப நாள்"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#1B5E20" />
        </LinearLayout>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>

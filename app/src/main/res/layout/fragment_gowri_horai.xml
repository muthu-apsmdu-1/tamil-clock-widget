<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_gowri_horai"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Date Summary Strip + Live Digital Clock (Today Only) -->
    <LinearLayout
        android:id="@+id/layout_dynamic_date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">

        <TextView
            android:id="@+id/tv_header_strip_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tv_header_live_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Sub-Tab Switcher: Gowri Palan vs Horai -->
    <LinearLayout
        android:id="@+id/layout_sub_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/tab_btn_gowri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="கௌரி பலன்"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_btn_horai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:text="ஹோரை"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3-Column Table Header: நேரம் | பகல் | இரவு -->
    <LinearLayout
        android:id="@+id/layout_table_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="10">

        <!-- Column 1: நேரம் time-->
        <TextView
            android:id="@+id/tv_col_header_time"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="நேரம்"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <!-- Column 2: பகல் -->
        <LinearLayout
            android:id="@+id/col_header_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3.4"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_col_header_day_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="பகல்"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_col_header_day_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(06:00 AM – 06:00 PM)"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <!-- Column 3: இரவு -->
        <LinearLayout
            android:id="@+id/col_header_night"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3.4"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_col_header_night_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="இரவு"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_col_header_night_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(06:00 PM – 06:00 AM)"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable 3-Column Slot Rows -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_gowri_horai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:overScrollMode="always">

        <LinearLayout
            android:id="@+id/container_table_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Legend Strip -->
    <LinearLayout
        android:id="@+id/layout_legend_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_legend_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="குறிப்பு:"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_legend_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="நன்று – பச்சை நிறம்  |  தவிர்க்கவும் – சிவப்பு நிறம்"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

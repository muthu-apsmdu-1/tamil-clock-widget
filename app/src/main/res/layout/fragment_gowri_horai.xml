<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_gowri_horai"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Date Summary Strip -->
    <LinearLayout
        android:id="@+id/layout_dynamic_date_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:elevation="2dp"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp">

        <TextView
            android:id="@+id/tv_header_strip_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sub-Tab Switcher: Gowri Palan vs Horai -->
    <LinearLayout
        android:id="@+id/layout_sub_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/tab_btn_gowri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text="கௌரி பலன்"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_btn_horai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:text="ஹோரை"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Tables Container -->
    <ScrollView
        android:id="@+id/scroll_gowri_horai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Table 1: Gowri Palan -->
            <LinearLayout
                android:id="@+id/layout_gowri_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_gowri_day_header"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="பகல் கௌரி நேரம் (காலை 06:00 - மாலை 06:00)"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_gowri_day_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_gowri_night_header"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="இரவு கௌரி நேரம் (மாலை 06:00 - காலை 06:00)"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_gowri_night_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Table 2: Horai -->
            <LinearLayout
                android:id="@+id/layout_horai_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_horai_day_header"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="பகல் கிரக ஹோரை (காலை 06:00 - மாலை 06:00)"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_horai_day_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_horai_night_header"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="இரவு கிரக ஹோரை (மாலை 06:00 - காலை 06:00)"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/container_horai_night_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>

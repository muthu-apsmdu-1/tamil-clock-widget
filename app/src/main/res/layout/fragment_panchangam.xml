<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_panchangam"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_panchangam_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 1. Gregorian Date & Live Time Capsule -->
        <LinearLayout
            android:id="@+id/card_date_clock_capsule"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_big_gregorian_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.8"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="34sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/view_capsule_divider"
                android:layout_width="2.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/tc_banner_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/tc_banner_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Tamil & English Date Strip (3 Cards) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/card_tamil_year_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tv_banner_tamil_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_banner_tamil_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_tamil_date_weekday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tv_banner_tamil_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:includeFontPadding="false"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_banner_tamil_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_eng_month_weekday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tv_banner_eng_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_banner_eng_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Content Frames: Simple & Expanded Panchangam -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">

            <!-- Simple Mode Layout -->
            <LinearLayout
                android:id="@+id/layout_simple_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/card_simple_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="2dp"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_simple_panchangam_paragraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/btn_toggle_expand"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="3dp" />

                    <ImageButton
                        android:id="@+id/btn_toggle_expand"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_crop"
                        android:contentDescription="Expand" />
                </RelativeLayout>

                <!-- Good Time Slots -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/card_nalla_neram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:elevation="2dp"
                        android:layout_marginEnd="2.5dp"
                        android:padding="6dp">

                        <TextView 
                            android:id="@+id/lbl_nalla_neram"
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content" 
                            android:text="நல்ல நேரம்" 
                            android:textStyle="bold" 
                            android:textSize="12.5sp" />

                        <TextView 
                            android:id="@+id/tv_simple_nalla_neram_morning" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" 
                            android:textStyle="bold" />

                        <TextView 
                            android:id="@+id/tv_simple_nalla_neram_evening" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:textSize="12sp" 
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_gowri_neram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:elevation="2dp"
                        android:layout_marginStart="2.5dp"
                        android:padding="6dp">

                        <TextView 
                            android:id="@+id/lbl_gowri_neram"
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content" 
                            android:text="கௌரி ந. நேரம்" 
                            android:textStyle="bold" 
                            android:textSize="12.5sp" />

                        <TextView 
                            android:id="@+id/tv_simple_gowri_morning" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:layout_marginTop="2dp"
                            android:textSize="12sp" 
                            android:textStyle="bold" />

                        <TextView 
                            android:id="@+id/tv_simple_gowri_evening" 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:textSize="12sp" 
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Rahu, Yamagandam, Kuligai -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/card_rahu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/lbl_rahu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="இராகு"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_simple_rahu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_yamagandam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/lbl_yamagandam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="எமகண்டம்"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_simple_yamagandam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_kuligai"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/lbl_kuligai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="குளிகை"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_simple_kuligai"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Soolam & Parikaram -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/card_soolam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="2.5dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/lbl_soolam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="சூலம் : "
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_simple_soolam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_parikaram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2.5dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/lbl_parikaram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="பரிகாரம் : "
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_simple_parikaram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Chandrashtamam -->
                <TextView
                    android:id="@+id/tv_simple_chandrashtamam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingVertical="7dp"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- Rasi Chart -->
                <LinearLayout
                    android:id="@+id/card_rasi_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:elevation="2dp"
                    android:layout_marginTop="5dp"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/tv_rasi_header_title"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="இன்றைய ராசிபலன்"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 4 Rows x 3 Columns -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:paddingVertical="4dp">
                        <TextView android:id="@+id/tv_rasi_mesham" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_rishabam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_mithunam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:paddingVertical="4dp">
                        <TextView android:id="@+id/tv_rasi_kadagam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_simmam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_kanni" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:paddingVertical="4dp">
                        <TextView android:id="@+id/tv_rasi_thulaam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_viruchigam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_dhanusu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:paddingVertical="4dp">
                        <TextView android:id="@+id/tv_rasi_magaram" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_kumbam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_rasi_meenam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded Mode Layout -->
            <LinearLayout
                android:id="@+id/layout_expanded_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_exp_mode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"
                        android:text="முழு பஞ்சாங்கம்"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_toggle_collapse"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:contentDescription="Collapse" />
                </RelativeLayout>

                <!-- Sun & Moon Dual Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="5dp">

                    <LinearLayout
                        android:id="@+id/card_exp_sun"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tv_exp_sun_timings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_exp_moon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tv_exp_moon_timings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Expanded Rows -->
                <LinearLayout
                    android:id="@+id/card_exp_tithi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="🌔" android:textSize="18sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/lbl_exp_tithi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="திதி" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_exp_tithi_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_exp_nakshatra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="⭐" android:textSize="18sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/lbl_exp_nakshatra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="நட்சத்திரம்" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_exp_nakshatra_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_exp_yoga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="☸" android:textSize="18sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/lbl_exp_yoga" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="யோகம்" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_exp_amritadi_yoga" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_exp_chandrashtamam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:orientation="horizontal">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="⚠️" android:textSize="17sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/lbl_exp_chandrashtamam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="சந்திராஷ்டமம்" android:textSize="12sp" android:textStyle="bold" />

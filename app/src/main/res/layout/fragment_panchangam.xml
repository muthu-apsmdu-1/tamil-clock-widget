<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E24"
    android:padding="8dp">

    <!-- 1. Centered Curved Banner Badge with Amber-Gold Border -->
    <TextView
        android:id="@+id/tv_app_title_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_gold_header_texture"
        android:text="தமிழ் நாட்காட்டி"
        android:textColor="#FFD043"
        android:textSize="22sp"
        android:textStyle="bold"
        android:shadowColor="#1A0000"
        android:shadowDx="1.5"
        android:shadowDy="2.0"
        android:shadowRadius="2.0"
        android:includeFontPadding="false" />

    <!-- 2. Individual Rounded Teal/Cyan Action Boxes -->
    <LinearLayout
        android:id="@+id/layout_nav_toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="7"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/btn_action_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="❮❮"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_action_datepicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="📅"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_menu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="🏠"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_horai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="☸"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btn_action_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_header_btn_ripple"
            android:gravity="center"
            android:text="❯❯"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ஆங்கில தேதி & நேரம் (Date + Time Split Capsule) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clock_square_ivory"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp">

        <!-- Left: Bold Gregorian Date -->
        <TextView
            android:id="@+id/tv_big_gregorian_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.8"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1-1-2027"
            android:textColor="#081E7D"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Center: Gold Vertical Accent Line -->
        <View
            android:layout_width="2.5dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="6dp"
            android:background="#C89218" />

        <!-- Right: Time & AM/PM Stack -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/tc_banner_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#0D7338"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/tc_banner_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:includeFontPadding="false"
                android:textColor="#0D7338"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>


        <!-- தமிழ் & ஆங்கில விபரம் (3 Individual Rounded Cards) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:weightSum="3">

    <!-- 1. தமிழ் & ஆங்கில விபரம் (Tamil & English Date Strip) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Left Box: Tamil Year & Month -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_row4_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_banner_tamil_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextTamilPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_banner_tamil_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/themeTextTamilPrimary"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Box: Tamil Date Number & Day -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_row4_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_banner_tamil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="?attr/themeTextTamilPrimary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_banner_tamil_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextTamilPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Box: English Month & Day -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_row4_chip"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_banner_eng_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextEnglishPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_banner_eng_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/themeTextEnglishPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Panchangam Paragraph Card -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_row4_chip"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_simple_panchangam_paragraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/themeTextBody"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <ImageButton
            android:id="@+id/btn_toggle_expand"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_crop" />
    </RelativeLayout>

    <!-- 3. Nalla Neram Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_row4_chip"
            android:layout_marginEnd="3dp"
            android:padding="6dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="நல்ல நேரம்"
                android:textColor="?attr/themeTextGreenAccent"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_simple_nalla_neram_morning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextBody"
                android:textSize="11.5sp" />
            <TextView
                android:id="@+id/tv_simple_nalla_neram_evening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextBody"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_row4_chip"
            android:layout_marginStart="3dp"
            android:padding="6dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="கௌரி ந. நேரம்"
                android:textColor="?attr/themeTextGreenAccent"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_simple_gowri_morning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextBody"
                android:textSize="11.5sp" />
            <TextView
                android:id="@+id/tv_simple_gowri_evening"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextBody"
                android:textSize="11.5sp" />
        </LinearLayout>


    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">

        <LinearLayout
            android:id="@+id/layout_simple_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFDF5"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_simple_panchangam_paragraph"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1E1E24"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:text="சித்திரை, திதி..." />

                <ImageButton
                    android:id="@+id/btn_toggle_expand"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackground"
                    android:src="@android:drawable/ic_menu_crop" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_simple_chandrashtamam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#FFF9E6"
                android:textColor="#B71C1C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="3dp"
                android:layout_marginTop="3dp"
                android:text="சந்திராஷ்டமம் : மீனம்" />

            <!-- நல்ல நேரம் & கௌரி நேரம் -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#FFFDF5"
                    android:layout_marginEnd="2dp"
                    android:padding="4dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="நல்ல நேரம்" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_simple_nalla_neram_morning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#333333" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_simple_nalla_neram_evening" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#333333" android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#FFFDF5"
                    android:layout_marginStart="2dp"
                    android:padding="4dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="கௌரி ந. நேரம்" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:id="@+id/tv_simple_gowri_morning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#333333" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_simple_gowri_evening" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#333333" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ராகு, எமகண்டம், குளிகை, சூலம், பரிகாரம் -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFDF5"
                android:layout_marginTop="3dp"
                android:padding="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="#B71C1C" android:weightSum="5">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="இராகு" android:textColor="#FFFFFF" android:textSize="10.5sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="எமகண்டம்" android:textColor="#FFFFFF" android:textSize="10.5sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="குளிகை" android:textColor="#FFFFFF" android:textSize="10.5sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="சூலம்" android:textColor="#FFFFFF" android:textSize="10.5sp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="பரிகாரம்" android:textColor="#FFFFFF" android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="5" android:paddingTop="3dp">
                    <TextView android:id="@+id/tv_simple_rahu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="9.5sp" />
                    <TextView android:id="@+id/tv_simple_yamagandam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="9.5sp" />
                    <TextView android:id="@+id/tv_simple_kuligai" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="9.5sp" />
                    <TextView android:id="@+id/tv_simple_soolam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10sp" />
                    <TextView android:id="@+id/tv_simple_parikaram" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. இன்றைய ராசிபலன்: 4 வரிசைகள் x வரிசைக்கு 3 ராசிகள் (4 Rows x 3 Rasi) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFDF5"
                android:layout_marginTop="3dp"
                android:padding="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:background="#800000"
                    android:text="இன்றைய ராசிபலன்"
                    android:textColor="#FFDF00"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Row 1: மேஷம், ரிஷபம், மிதுனம் -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3" android:paddingVertical="2dp">
                    <TextView android:id="@+id/tv_rasi_mesham" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_rishabam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_mithunam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: கடகம், சிம்மம், கன்னி -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3" android:paddingVertical="2dp">
                    <TextView android:id="@+id/tv_rasi_kadagam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_simmam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_kanni" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3: துலாம், விருச்சிகம், தனுசு -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3" android:paddingVertical="2dp">
                    <TextView android:id="@+id/tv_rasi_thulaam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_viruchigam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_dhanusu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 4: மகரம், கும்பம், மீனம் -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="3" android:paddingVertical="2dp">
                    <TextView android:id="@+id/tv_rasi_magaram" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_kumbam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_rasi_meenam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#222" android:textSize="10.5sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Expanded Mode Layout (அப்படியே இருக்கும்) -->
        <LinearLayout
            android:id="@+id/layout_expanded_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/btn_toggle_collapse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/themeCanvasBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- 1. TOP CRIMSON DATE NAVIGATOR CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_header_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#5D0A14">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:paddingHorizontal="12dp">

                <ImageButton
                    android:id="@+id/btn_prev_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_header_btn_ripple"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_circle_prev"
                    android:contentDescription="முந்தைய நாள்" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_gregorian_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="29 - 10 - 2026 வியாழன்" />

                    <TextView
                        android:id="@+id/tv_tamil_date_full"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#FFDF00"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="பராபவ - ஐப்பசி 12" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_next_day"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_header_btn_ripple"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_circle_next"
                    android:contentDescription="அடுத்த நாள்" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. FESTIVAL / EVENT BADGE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_festival_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFF8E1"
            app:strokeWidth="1dp"
            app:strokeColor="#FFE082"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_festival_badge_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:textColor="#BF360C"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="🎉 சங்கடஹர சதுர்த்தி" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. DUAL CARDS: SUN & MOON TIMES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/themeCardBackground"
                app:strokeWidth="1.5dp"
                app:strokeColor="#701018">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/clock_dial_classic"
                        android:contentDescription="சூரியன்" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tv_sunrise_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#5D0A14"
                            tools:text="↑  06:08 AM" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D1D1D6"
                            android:layout_marginVertical="5dp" />

                        <TextView
                            android:id="@+id/tv_sunset_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#5D0A14"
                            tools:text="↓  05:57 PM" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/themeCardBackground"
                app:strokeWidth="1.5dp"
                app:strokeColor="#701018">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/clock_dial_classic"
                        android:contentDescription="சந்திரன்" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tv_moonrise_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#5D0A14"
                            tools:text="↑  03:00 PM" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D1D1D6"
                            android:layout_marginVertical="5dp" />

                        <TextView
                            android:id="@+id/tv_moonset_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#5D0A14"
                            tools:text="↓  03:12 AM" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 4. EXPANDABLE / COLLAPSIBLE PANCHANGAM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_panchangam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/themeCardBackground"
            app:strokeColor="#C5A059"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_panchangam_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="தினசரி பஞ்சாங்கம்"
                        android:textColor="#5D0A14"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_toggle_expand"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="விரிவாக்கு / சுருக்கு"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_fullscreen" />
                </RelativeLayout>

                <!-- Compact View -->
                <LinearLayout
                    android:id="@+id/layout_compact_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_panchangam_paragraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#263238"
                        android:textSize="14sp"
                        tools:text="நட்சத்திரம் : ரோகிணி - 15:27 வரை, திதி : சதுர்த்தி - 02:21* வரை..." />
                </LinearLayout>

                <!-- Expanded View -->
                <LinearLayout
                    android:id="@+id/layout_expanded_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_paksham_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        tools:text="• பக்ஷம்: கிருஷ்ண பக்ஷம்" />

                    <TextView
                        android:id="@+id/tv_tithi_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        tools:text="• திதி: சதுர்த்தி (02:21* வரை)" />

                    <TextView
                        android:id="@+id/tv_nakshatra_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        tools:text="• நட்சத்திரம்: ரோகிணி (15:27 வரை)" />

                    <TextView
                        android:id="@+id/tv_yoga_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        tools:text="• யோகம்: பரிகம் (03:02* வரை)" />

                    <TextView
                        android:id="@+id/tv_karana_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        tools:text="• கரணம்: பவ (15:07 வரை)" />

                    <TextView
                        android:id="@+id/tv_detail_tyajyam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="3dp"
                        android:textColor="#C62828"
                        android:textSize="13sp"
                        tools:text="• தியாஜ்யம்: 07:58" />

                    <TextView
                        android:id="@+id/tv_detail_festivals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:textColor="#1B5E20"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="• சிறப்பு நிகழ்வுகள்: சங்கடஹர சதுர்த்தி" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. AUSPICIOUS TIMINGS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/themeCardBackground"
            app:strokeWidth="1dp"
            app:strokeColor="#A3D9AC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="சுப நேரங்கள்"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nalla_neram_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    tools:text="நல்ல நேரம்: 10:45 - 11:45 / 12:15 - 01:15" />

                <TextView
                    android:id="@+id/tv_gouri_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    tools:text="கௌரி நல்ல நேரம்: 06:30 - 07:30" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. INAUSPICIOUS TIMINGS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="?attr/themeCardBackground"
            app:strokeWidth="1dp"
            app:strokeColor="#FFCDD2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="அசுப நேரங்கள்"
                    android:textColor="#B71C1C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rahu_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    tools:text="இராகு காலம்: 01:30 - 03:00" />

                <TextView
                    android:id="@+id/tv_yamagandam_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    tools:text="எமகண்டம்: 06:00 - 07:30" />

                <TextView
                    android:id="@+id/tv_kuligai_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    tools:text="குளிகை: 09:00 - 10:30" />

                <TextView
                    android:id="@+id/tv_tyajyam_val"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="தியாஜ்யம்: 07:58"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Background Bitmap Layer (Theme color, opacity, rounded corners & border) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Main Container: Exactly 1:1 Split (Clock Half : Information Half) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:weightSum="2">

        <!-- LEFT HALF: Clock Container (Exact half width) -->
        <FrameLayout
            android:id="@+id/container_clock_half"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp">

            <!-- Classic Vintage Analog Clock (Direct on theme background, no extra plate) -->
            <AnalogClock
                android:id="@+id/analog_clock_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:dial="@drawable/classic_clock_dial"
                android:hand_hour="@drawable/classic_clock_hour"
                android:hand_minute="@drawable/classic_clock_minute"
                android:visibility="gone" />

            <!-- Digital Clock: Big time font with half-size AM/PM bound via SpannableString -->
            <TextView
                android:id="@+id/tv_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Vertical Accent Divider -->
        <View
            android:id="@+id/view_center_divider"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="6dp"
            android:layout_marginHorizontal="3dp"
            android:background="#44FFDF00" />

        <!-- RIGHT HALF: Elements (Horizontally Centered, Vertically Justified) -->
        <LinearLayout
            android:id="@+id/container_elements_half"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="4dp"
            android:weightSum="2">

            <!-- Row 1: Gregorian Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Row 2: Tamil Month & Tamil Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_tamil_month_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_pill"
    android:padding="6dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp">

        <AnalogClock
            android:id="@+id/clock_analog_2x1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/clock_dial_classic"
            android:visibility="visible" />

        <TextClock
            android:id="@+id/clock_digital_2x1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_2x1_greg_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24-10-2026"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_2x1_tamil_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="ஐப்பசி 4 சனி"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFDF00" />
    </LinearLayout>
</LinearLayout>

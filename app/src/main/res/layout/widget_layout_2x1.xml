<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Background -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Main Container: 1:1 Split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="2dp"
        android:weightSum="2">

        <!-- LEFT HALF: Clock Container -->
        <FrameLayout
            android:id="@+id/container_clock_half"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp">

            <!-- Square Analog Dial and Hands -->
            <FrameLayout
                android:id="@+id/container_hybrid_clock_square"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Hybrid / AMOLED White Dial -->
                <ImageView
                    android:id="@+id/iv_hybrid_dial_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Analog Dial" />

                <!-- Native Analog Clock Hands -->
                <AnalogClock
                    android:id="@+id/analog_clock_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:dial="@drawable/classic_clock_dial"
                    android:hand_hour="@drawable/classic_clock_hour"
                    android:hand_minute="@drawable/classic_clock_minute"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Hybrid Top Digital Time -->
            <TextClock
                android:id="@+id/tc_hybrid_top_digital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="12dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#00F5D4"
                android:textSize="9sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <!-- Digital Clock Background -->
            <ImageView
                android:id="@+id/iv_digital_clock_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:contentDescription="Neon Digital Pill" />

            <!-- Digital Clock Container -->
            <LinearLayout
                android:id="@+id/container_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <!-- Main Time -->
                <TextClock
                    android:id="@+id/tv_digital_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <!-- AM / PM -->
                <TextClock
                    android:id="@+id/tv_digital_clock_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </FrameLayout>

        <!-- RIGHT HALF: Date Information -->
        <LinearLayout
            android:id="@+id/container_elements_half"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp"
            android:weightSum="2">

            <!-- Gregorian Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10.5sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <!-- Tamil Month and Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_tamil_month_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10.5sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>


            <!-- Gregorian Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <!-- Tamil Month and Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_widget_tamil_month_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

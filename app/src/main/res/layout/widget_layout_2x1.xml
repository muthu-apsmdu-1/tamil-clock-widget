<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_surface_bg">

    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp">

        <AnalogClock
            android:id="@+id/analog_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/classic_clock_dial"
            android:visibility="visible" />

        <TextClock
            android:id="@+id/digital_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#FFDF00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        android:layout_marginStart="8dp">

        <!-- 6. Text wrap ஆகாமல் இருக்க dd - MM - yy -->
        <TextView
            android:id="@+id/tv_widget_greg_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="08 - 11 - 26" />

        <TextView
            android:id="@+id/tv_widget_tamil_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFDF00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:text="ஐப்பசி 22" />
    </LinearLayout>
</LinearLayout>

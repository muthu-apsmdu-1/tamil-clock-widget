<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- 2. Main Container: Clock 1/4 + Information 3/4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="2dp"
        android:weightSum="4">

        <!-- LEFT AREA: Clock (1/4) -->
        <FrameLayout
            android:id="@+id/container_clock_quarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp">

            <!-- Shared square area for Hybrid dial and analog hands -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_hybrid_clock_square"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Hybrid / AMOLED White Dial -->
                <ImageView
                    android:id="@+id/iv_hybrid_dial_bg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Analog Dial"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Native Analog Clock Hands -->
                <AnalogClock
                    android:id="@+id/analog_clock_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:dial="@drawable/classic_clock_dial"
                    android:hand_hour="@drawable/classic_clock_hour"
                    android:hand_minute="@drawable/classic_clock_minute"
                    android:visibility="gone"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Hybrid Digital Time -->
            <TextClock
                android:id="@+id/tc_hybrid_top_digital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="12dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#00F5D4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="gone" />

            <!-- AMOLED Neon Digital Background -->
            <ImageView
                android:id="@+id/iv_digital_clock_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:contentDescription="Neon Digital Pill" />

            <!-- Digital Clock -->
            <LinearLayout
                android:id="@+id/container_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextClock
                    android:id="@+id/tv_digital_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/tv_digital_clock_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </FrameLayout>

        <!-- RIGHT AREA: Information (3/4) -->
        <LinearLayout
            android:id="@+id/container_elements_three_quarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:weightSum="2">

            <!-- Row 1: Gregorian Date + Weekday -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

            </LinearLayout>

            <!-- Row 2: Tamil Date + Paksham / Thithi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_tamil_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_paksham_thithi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

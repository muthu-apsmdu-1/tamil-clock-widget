<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Dynamic Background Bitmap Layer (Theme color, opacity, rounded corners & border) -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- 2. Main Container: Split 1:3 (Clock = 1/4, Balance Area = 3/4) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:weightSum="4">

        <!-- LEFT AREA: Clock Container (Exact 1/4 of Widget Width = weight 1) -->
        <FrameLayout
            android:id="@+id/container_clock_quarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp">

            <!-- Classic Vintage Analog Clock (Direct on theme background, no extra plate) -->
            <AnalogClock
                android:id="@+id/analog_clock_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:dial="@drawable/classic_clock_dial"
                android:hand_hour="@drawable/classic_clock_hour"
                android:hand_minute="@drawable/classic_clock_minute"
                android:visibility="gone" />

            <!-- Digital Clock: Big time font with half-size AM/PM bound via SpannableString -->
            <TextView
                android:id="@+id/tv_digital_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:visibility="visible" />
        </FrameLayout>


        <!-- RIGHT AREA: Balance Elements (Exact 3/4 of Widget Width = weight 3) -->
        <LinearLayout
            android:id="@+id/container_elements_three_quarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:weightSum="2">

            <!-- Row 1: Gregorian Date (Type optional via Settings) + Tamil Weekday -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_greg_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="7"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Row 2: Tamil Month & Tamil Date + Converted Paksham & Thithi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_tamil_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="7sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_paksham_thithi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="7sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

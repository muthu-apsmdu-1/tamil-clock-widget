<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Frame / Bevel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#36060B" />
        </shape>
    </item>

    <!-- Brass / Gold Inner Rim -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#D4AF37" />
            <solid android:color="#220306" />
        </shape>
    </item>

    <!-- Warm Antique Ivory Dial Face -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFDF5" />
            <stroke android:width="1dp" android:color="#E0DACB" />
        </shape>
    </item>
</layer-list>

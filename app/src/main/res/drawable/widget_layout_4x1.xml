<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x1_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_pill"
    android:padding="6dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp">

        <AnalogClock
            android:id="@+id/clock_analog_4x1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/clock_dial_classic"
            android:visibility="visible" />

        <TextClock
            android:id="@+id/clock_digital_4x1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_4x1_dates_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24-10-2026 | ஐப்பசி 4"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_4x1_tithi_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="சனி - திரியோதசி"
            android:textSize="12sp"
            android:textColor="#FFDF00" />
    </LinearLayout>
</LinearLayout>

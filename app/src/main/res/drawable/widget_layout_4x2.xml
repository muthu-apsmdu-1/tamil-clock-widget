<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_vertical">

            <AnalogClock
                android:id="@+id/clock_analog_4x2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/clock_dial_classic"
                android:visibility="visible" />

            <TextClock
                android:id="@+id/clock_digital_4x2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_4x2_greg_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 - 10 - 2026"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_4x2_tamil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ஐப்பசி 4 சனி"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFDF00" />

            <TextView
                android:id="@+id/tv_4x2_tithi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="திரியோதசி"
                android:textSize="14sp"
                android:textColor="#E0DACB" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_4x2_nakshatra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="★ உத்திரட்டாதி 8.13 pm வரை"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFDF00" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Perfect Round Outer Bezel Frame (Centered at 100,100 with radius 84) -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M 16,100 A 84,84 0 1,1 184,100 A 84,84 0 1,1 16,100" />

    <!-- 12 O'CLOCK: Twin-bar pin (split vertical bars) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M95.5,24 h3.2 v16 h-3.2 z M101.3,24 h3.2 v16 h-3.2 z" />

    <!-- 3 O'CLOCK: Twin-bar pin (split horizontal bars) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M160,95.5 h16 v3.2 h-16 z M160,101.3 h16 v3.2 h-16 z" />

    <!-- 6 O'CLOCK: Twin-bar pin (split vertical bars) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M95.5,160 h3.2 v16 h-3.2 z M101.3,160 h3.2 v16 h-3.2 z" />

    <!-- 9 O'CLOCK: Twin-bar pin (split horizontal bars) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,95.5 h16 v3.2 h-16 z M24,101.3 h16 v3.2 h-16 z" />

</vector>

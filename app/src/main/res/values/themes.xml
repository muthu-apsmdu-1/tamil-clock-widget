<resources>

    <!-- 1. Ivory Cream (Default) - Warm Authentic Panchangam Look -->
    <style name="Theme.TamilClock.IvoryCream" parent="Theme.AppCompat.NoActionBar">
        <item name="themeCardBg">#FFFDF2</item>
        <item name="themeCardStroke">#8A0B1A</item>

        <!-- Multi-Color Text -->
        <item name="themeTextTamilPrimary">#8A0B1A</item>   <!-- Deep Maroon -->
        <item name="themeTextEnglishPrimary">#081E7D</item> <!-- Royal Navy -->
        <item name="themeTextGreenAccent">#1B5E20</item>    <!-- Dark Green -->
        <item name="themeTextBody">#1A1A1A</item>           <!-- Sharp Charcoal Black -->
        <item name="themeTextSub">#333333</item>
    </style>

    <!-- 2. Pure White -->
    <style name="Theme.TamilClock.White" parent="Theme.AppCompat.NoActionBar">
        <item name="themeCardBg">#FFFFFF</item>
        <item name="themeCardStroke">#C89218</item>

        <!-- Multi-Color Text -->
        <item name="themeTextTamilPrimary">#8A0B1A</item>
        <item name="themeTextEnglishPrimary">#081E7D</item>
        <item name="themeTextGreenAccent">#1B5E20</item>
        <item name="themeTextBody">#1A1A1A</item>
        <item name="themeTextSub">#333333</item>
    </style>

    <!-- 3. Light Yellow (Sandalwood / Chandanam) -->
    <style name="Theme.TamilClock.LightYellow" parent="Theme.AppCompat.NoActionBar">
        <item name="themeCardBg">#FFF8DC</item>
        <item name="themeCardStroke">#B87333</item>

        <!-- Multi-Color Text -->
        <item name="themeTextTamilPrimary">#8A0B1A</item>
        <item name="themeTextEnglishPrimary">#081E7D</item>
        <item name="themeTextGreenAccent">#1B5E20</item>
        <item name="themeTextBody">#212121</item>
        <item name="themeTextSub">#333333</item>
    </style>

    <!-- 4. Light Green (Fresh Tender Leaf) -->
    <style name="Theme.TamilClock.LightGreen" parent="Theme.AppCompat.NoActionBar">
        <item name="themeCardBg">#EBF7EE</item>
        <item name="themeCardStroke">#2E7D32</item>

        <!-- Multi-Color Text -->
        <item name="themeTextTamilPrimary">#8A0B1A</item>
        <item name="themeTextEnglishPrimary">#081E7D</item>
        <item name="themeTextGreenAccent">#0A5C2A</item>
        <item name="themeTextBody">#1A1A1A</item>
        <item name="themeTextSub">#2E3830</item>
    </style>

    <!-- 5. Charcoal (Black) - Crisp White Single Color Text -->
    <style name="Theme.TamilClock.Charcoal" parent="Theme.AppCompat.NoActionBar">
        <item name="themeCardBg">#282832</item>
        <item name="themeCardStroke">#48485A</item>

        <!-- Single White Text Color for Dark Mode -->
        <item name="themeTextTamilPrimary">#FFFFFF</item>
        <item name="themeTextEnglishPrimary">#FFFFFF</item>
        <item name="themeTextGreenAccent">#FFFFFF</item>
        <item name="themeTextBody">#FFFFFF</item>
        <item name="themeTextSub">#E0E0E0</item>
    </style>

</resources>
